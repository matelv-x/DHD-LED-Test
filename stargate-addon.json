{
  "maintenance_contract": 1,
  "uninstall_contract": 2,
  "id": "dhd-led-test",
  "name": "DHD LED Test",
  "repository": "matelv-x/DHD-LED-Test",
  "platforms": ["v4"],
  "detect": {"any": [{"path": "test/dhd_test_from_config.py"}, {"path": "web/debug.htm", "contains": "DHD LED TEST UNIVERSAL PATCH START"}]},
  "install": {"argv": ["./install.sh", "{sg1_root}"], "timeout": 1200},
